# ============================================================
# SHEcure — Environment Variables
# COPY this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# Flask secret key — change to a long random string
SECRET_KEY=change-me-to-a-long-random-string-in-production

# PostgreSQL connection URL (Railway provides this automatically)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/shecure

# Admin account seed (used on first launch only)
ADMIN_EMAIL=fernandezmariamcollege@gmail.com
ADMIN_PASSWORD=SHEcure2025!

# Camera source
# 0          = local webcam
# rtsp://... = CCTV camera RTSP stream URL
CAMERA_SOURCE=0

# Set to "true" to enforce IP allow-list (blocks anyone not in the list)
ENFORCE_IP_ALLOWLIST=false

# Flask environment
FLASK_ENV=production
