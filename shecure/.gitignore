# ============================================================
# SHEcure — .gitignore
# Keep secrets, hardware credentials, and local data private
# ============================================================

# ── Environment & Secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.secret
secrets.py
config_local.py

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
MANIFEST

# ── Virtual environments ─────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# ── Database files (never commit local DBs) ──────────────────
*.db
*.sqlite
*.sqlite3
instance/
migrations/versions/*.py

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
*.out

# ── Camera / Media ───────────────────────────────────────────
recordings/
snapshots/
*.mp4
*.avi
*.mkv
*.jpg
*.jpeg
*.png
*.gif
app/static/uploads/

# ── OS & Editor ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo
*~

# ── Testing ──────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── Security-sensitive files (never expose) ──────────────────
# These files contain logic that must stay private:
#   app/utils/security.py   — IP allow-list + activity tracking
#   .env                    — All credentials and keys
#   instance/               — Local Flask instance folder
app/utils/security_overrides.py

# ── Local agent (runs on LAN machine, never pushed to GitHub) ────────────────
agent.py
agent*.py
pusher.py

.railway/
.vercel/
*.tar.gz
*.zip
